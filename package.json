{
  "name": "dsh-model-coordinates",
  "version": "0.1.1",
  "description": "评测你可用的模型，对比能力与耗时，选择适合当前任务的配置。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangZhengruiNUS/dsh-plugin-model-eval.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "model-evaluation"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node scripts/test.mjs all",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "resources/**",
    "docs/design/protocol-releases.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
